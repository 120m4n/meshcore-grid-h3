JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
H3_RESOLUTION=8
PUBLIC_API_URL=https://api.meshcore.example.com
# Dominio real del frontend — restringe CORS en el backend. "*" es un
# escape hatch explícito para dev local, no usar en producción.
WEB_ORIGIN=https://meshcore.example.com

# API DEM (elevación) usada por /api/v1/simulations/radial. Default en
# docker-compose.yml apunta a una instancia de pruebas en el host
# (host.docker.internal:8000) — sobreescribir acá con el endpoint real.
DEM_API_URL=http://host.docker.internal:8000

# Espacia las llamadas salientes al DEM (0 = sin límite). 40 = calibrado
# empíricamente contra la instancia de pruebas: sostenido durante 35s y
# 71s seguidos (1441 y 2881 llamadas) sin ningún 429; 80 sostenido sí
# falló a los ~17s. No es un límite de concurrencia (ráfagas aisladas de
# 100-150 igual pasan), es una ventana de tiempo — recalibrar si
# el rate limit real del lado del DEM cambia.
DEM_MAX_REQUESTS_PER_SEC=40
